{
  "name": "build-ai-apps",
  "description": "Build Agentic AI Applications with Node.js and LangChain",
  "keywords": ["node", "ai", "langchain", "langsmith", "heroku", "mia"],
  "website": "https://github.com/heroku-examples/build-ai-apps-talk",
  "repository": "https://github.com/heroku-examples/build-ai-apps-talk",
  "success_url": "/",
  "env": {
    "OPENWEATHER_API_KEY": {
      "description": "Your OpenWeather API Key",
      "required": false
    }
  },
  "addons": [
    "heroku-postgresql:essential-0",
    "heroku-inference:claude-3-7-sonnet",
    "heroku-inference:cohere-embed-multilingual"
  ],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
