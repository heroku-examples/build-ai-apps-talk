{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "lib/**",
      "utils/**",
      "types/**",
      "hooks/**",
      "styles/**",
      "public/**",
      "test/**",
      "scripts/**",
      "config/**",
      "utils/**",
      "types/**",
      "hooks/**",
      "styles/**",
      "public/**",
      "test/**",
      "scripts/**",
      "config/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": "off",
        "noUnknownAtRules": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  }
}
